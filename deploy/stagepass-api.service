# systemd keeps the API running: starts it on boot and restarts it if it crashes.
# setup.sh replaces __APP_DIR__ with the folder you cloned the repo into.

[Unit]
Description=Stagepass API
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=stagepass
WorkingDirectory=__APP_DIR__/api
EnvironmentFile=/etc/stagepass/api.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/env node dist/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
